<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KikitanTranslator-Setup</AssemblyName>
    <RootNamespace>KikitanInstaller</RootNamespace>
    <Product>Kikitan Translator Setup</Product>
    <Company>Kikitan</Company>
    <Version>2.3.0</Version>
    <ApplicationIcon>..\KikitanTranslator.Photino\Resources\wwwroot\kikitan_logo.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" LogicalName="KikitanInstaller.payload.zip" />
    <EmbeddedResource Include="..\KikitanTranslator.Photino\Resources\wwwroot\kikitan_logo.ico" LogicalName="app_icon.ico" />
  </ItemGroup>
</Project>
