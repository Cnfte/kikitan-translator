<Window x:Class="KikitanInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kikitan Translator v2.3.0 安装向导"
        Width="820" Height="620"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Background="{StaticResource BgCanvas}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!-- ==================== HEADER & STEPPER ==================== -->
            <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="28,16,18,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title Row + Custom Window Controls -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0"
                                BorderBrush="#3338BDF8" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1F3B6D" Offset="0" />
                                    <GradientStop Color="#13203B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image x:Name="AppLogoImage" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Kikitan Translator" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <Border Background="{StaticResource AccentBlueSoft}" BorderBrush="#440A84FF" BorderThickness="1"
                                        CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="v2.3.0" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="VRChat 语音翻译与桌面聚合双语悬浮窗 · 交互式安装向导"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,-4,0,0">
                            <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="最小化">
                                <Path Data="M 0,0 L 10,0" Width="10" Height="1.5" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                            </Button>
                            <Button Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" ToolTip="关闭">
                                <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Width="9" Height="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 4-Step Connected Indicator -->
                    <Grid Grid.Row="1" Margin="0,16,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge0" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentBlue}">
                                <Grid>
                                    <TextBlock x:Name="StepNum0" Text="1" FontSize="11.5" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="StepCheck0" Data="M 0,3.5 L 3.2,6.8 L 9.2,0.5" Width="9.5" Height="7.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StepText0" Text="环境与依赖检测" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="StepLine0" Grid.Column="1" Height="1.5" Background="{StaticResource BorderSubtle}" Margin="12,0" VerticalAlignment="Center" />

                        <!-- Step 2 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge1" Width="22" Height="22" CornerRadius="11" Background="#252C3E">
                                <Grid>
                                    <TextBlock x:Name="StepNum1" Text="2" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="StepCheck1" Data="M 0,3.5 L 3.2,6.8 L 9.2,0.5" Width="9.5" Height="7.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StepText1" Text="安装路径与选项" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="StepLine1" Grid.Column="3" Height="1.5" Background="{StaticResource BorderSubtle}" Margin="12,0" VerticalAlignment="Center" />

                        <!-- Step 3 -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge2" Width="22" Height="22" CornerRadius="11" Background="#252C3E">
                                <Grid>
                                    <TextBlock x:Name="StepNum2" Text="3" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="StepCheck2" Data="M 0,3.5 L 3.2,6.8 L 9.2,0.5" Width="9.5" Height="7.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StepText2" Text="正在安装" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border x:Name="StepLine2" Grid.Column="5" Height="1.5" Background="{StaticResource BorderSubtle}" Margin="12,0" VerticalAlignment="Center" />

                        <!-- Step 4 -->
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepBadge3" Width="22" Height="22" CornerRadius="11" Background="#252C3E">
                                <Grid>
                                    <TextBlock x:Name="StepNum3" Text="4" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="StepCheck3" Data="M 0,3.5 L 3.2,6.8 L 9.2,0.5" Width="9.5" Height="7.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                                          Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="StepText3" Text="完成" FontSize="12.5" FontWeight="Medium"
                                       Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ==================== CONTENT PAGES ==================== -->
            <Grid Grid.Row="1" Margin="28,20,28,16">

                <!-- PAGE 0: DEPENDENCY CHECK & INTERACTIVE INSTALL -->
                <Grid x:Name="PageDependencies" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Summary & Actions Row (Responsive 2-column Grid: zero overlap guaranteed) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtDepSummary" Text="正在自动检测本机必需运行库..."
                                       FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Text="缺失组件将自动从微软官方渠道下载并交互式引导安装。"
                                       FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRecheckDeps" Content="重新检测" Style="{StaticResource SecondaryButtonStyle}"
                                    Height="34" Padding="14,0" Click="RecheckDeps_Click" />
                            <Button x:Name="BtnInstallAllDeps" Content="一键安装全部缺失项" Style="{StaticResource PrimaryButtonStyle}"
                                    Height="34" Padding="16,0" Margin="10,0,0,0" Visibility="Collapsed" Click="InstallAllDeps_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- Dependency Cards List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="DependenciesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                            BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Status Circle Icon -->
                                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                    Background="{Binding IconBg}" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <Path Data="{Binding IconGeometry}"
                                                      Width="18" Height="18"
                                                      Stroke="{Binding IconBrush}"
                                                      StrokeThickness="2.1"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Title & Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11.5"
                                                           Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Status Pill + Per-Item Install Button -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{Binding PillBg}" BorderBrush="{Binding PillBorder}"
                                                        BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding PillForeground}" />
                                                </Border>
                                                <Button Content="安装此项" Style="{StaticResource MiniActionButtonStyle}"
                                                        Margin="10,0,0,0"
                                                        Visibility="{Binding InstallButtonVisibility}"
                                                        IsEnabled="{Binding CanInstall}"
                                                        Tag="{Binding}"
                                                        Click="InstallSingleDep_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Inline Download / Install Progress Strip -->
                    <Border x:Name="DepProgressPanel" Grid.Row="2" Visibility="Collapsed"
                            Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderStrong}"
                            BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,6,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock x:Name="TxtDepProgressStatus" Text="准备下载..." FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock x:Name="TxtDepProgressPct" Text="0%" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#60A5FA" HorizontalAlignment="Right" />
                            </Grid>
                            <ProgressBar x:Name="DepProgressBar" Style="{StaticResource ModernProgressBarStyle}" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- PAGE 1: PATH & INSTALLATION OPTIONS -->
                <StackPanel x:Name="PageOptions" Visibility="Collapsed">
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="目标安装目录" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="程序主文件与桌面悬浮窗将部署到此文件夹中，建议保留默认路径或选择高速固态磁盘。"
                                       FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInstallPath" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}"
                                         TextChanged="TxtInstallPath_TextChanged" />
                                <Button Grid.Column="1" Content="浏览..." Style="{StaticResource SecondaryButtonStyle}"
                                        Height="38" Margin="10,0,0,0" Click="BrowseFolder_Click" />
                                <Button Grid.Column="2" Content="恢复默认" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="38" Margin="8,0,0,0" Click="ResetPath_Click" />
                            </Grid>

                            <TextBlock x:Name="TxtDiskSpace" Text="预计占用空间: 计算中..."
                                       FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="2,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1" CornerRadius="12" Padding="20,18">
                        <StackPanel>
                            <TextBlock Text="系统集成与快捷方式" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,14" />

                            <UniformGrid Columns="2" Rows="2">
                                <CheckBox x:Name="ChkDesktopShortcut" Content="创建桌面快捷方式" Style="{StaticResource ModernCheckBoxStyle}"
                                          IsChecked="True" Margin="0,0,12,14" />
                                <CheckBox x:Name="ChkStartMenuShortcut" Content="创建开始菜单快捷方式" Style="{StaticResource ModernCheckBoxStyle}"
                                          IsChecked="True" Margin="0,0,0,14" />
                                <CheckBox x:Name="ChkPreserveConfig" Content="覆盖安装时保留已有配置与密钥" Style="{StaticResource ModernCheckBoxStyle}"
                                          IsChecked="True" Margin="0,0,12,0" />
                                <CheckBox x:Name="ChkRegisterUninstall" Content="注册到 Windows「已安装的应用」" Style="{StaticResource ModernCheckBoxStyle}"
                                          IsChecked="True" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- PAGE 2: LIVE INSTALLATION PROGRESS -->
                <Border x:Name="PageProgress" Visibility="Collapsed"
                        Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="12" Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <TextBlock x:Name="TxtInstallStage" Text="正在准备部署..." FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TxtInstallPct" Text="0%" FontSize="14" FontWeight="Bold"
                                       Foreground="#60A5FA" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar x:Name="InstallProgressBar" Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}"
                                     Height="10" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16" />

                        <Border Grid.Row="2" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="10" Padding="10">
                            <TextBox x:Name="TxtInstallLog"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#B8C4DC" FontFamily="Consolas" FontSize="12"
                                     IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Border>
                    </Grid>
                </Border>

                <!-- PAGE 3: COMPLETION -->
                <Border x:Name="PageFinish" Visibility="Collapsed"
                        Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="14" Padding="32,28">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                        <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource AccentGreenSoft}"
                                BorderBrush="#4422C55E" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,18">
                            <Path Data="M 0,11 L 10,21 L 28,0"
                                  Width="28" Height="21"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource AccentGreen}"
                                  StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>

                        <TextBlock Text="Kikitan Translator 安装完成" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                        <TextBlock Text="主程序、嵌入式界面与单框聚合自动滚动桌面悬浮窗均已部署就绪。"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" Margin="0,6,0,20" />

                        <Border Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="安装位置" FontSize="11" Foreground="{StaticResource TextMuted}" />
                                    <TextBlock x:Name="TxtDonePath" Text="" FontFamily="Consolas" FontSize="12"
                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="打开文件夹" Style="{StaticResource SecondaryButtonStyle}"
                                        Height="32" Padding="12,0" FontSize="12" Click="OpenInstallFolder_Click" />
                            </Grid>
                        </Border>

                        <CheckBox x:Name="ChkLaunchAfter" Content="关闭向导后立即启动 Kikitan Translator"
                                  Style="{StaticResource ModernCheckBoxStyle}" IsChecked="True" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ==================== FOOTER ACTION BAR ==================== -->
            <Border Grid.Row="2" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0"
                    Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnCancel" Grid.Column="0" Content="取消" Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="90" Height="38" Click="Cancel_Click" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnBack" Content="← 上一步" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="104" Height="38" Margin="0,0,10,0" Visibility="Collapsed" Click="Back_Click" />
                        <Button x:Name="BtnPrimary" Content="下一步 →" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="136" Height="38" Click="Primary_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
